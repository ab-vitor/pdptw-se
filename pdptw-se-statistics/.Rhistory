columns_min_value[i],
columns_max_value[i],
by = round(columns_breaks[i], digits = 0)
))
print(p)
filename <-
paste(
"plots/",
methods[j],
variations[j],
"/pdf/all_insts/n_reqs/plot_",
columns[i],
"_vs_n_reqs_and_instance_",
methods_names[j],
variations[j],
".pdf",
sep = ""
)
ggsave(filename,
plot = p,
width = 7,
height = 6)
}
}
library(ggplot2)
inst_set <- c("I4", "F2", "I5", "F3")
inst_set_desc <- c("Multi-island", "Multi-floor", "Multi-island", "Multi-floor")
inst_set_group_name <- c("I", "F", "I", "F")
folder_inst_set <- c("","","multi_island_v5/", "multi_floor_v3/")
for (i in 3:4) {
stats_t1 <- read.csv(
file = paste("./inst_statistics/",
folder_inst_set[i],
"stats_",
inst_set[i],
"_type_1.csv",
sep = ""),
sep = ";"
)
stats_t1$type = "1"
stats_t2 <- read.csv(
file = paste("./inst_statistics/",
folder_inst_set[i],
"stats_",
inst_set[i],
"_type_2.csv",
sep = ""),
sep = ";"
)
stats_t2$type = "2"
stats <- rbind(stats_t1, stats_t2)
stats$n_regions <- substr(stats$group, 10, 10)
stats$group_num <- as.numeric(factor(stats$group))
stats$n_regions_num <- as.numeric(factor(stats$n_regions))
stats$tw_shift <- 100 * (stats$tw_shift)
stats$cap_incr <- 100 * (stats$cap_incr)
stats$reqs_split <- 100 * (stats$reqs_split)
unlim_cols <-
c(colnames(stats)[3:8])
unlim_cols_desc <- c(
"TW change (%)",
"Cap change (%)",
"Mean (z)",
"Std (z)",
"Var (z)",
"Chi-squared (z)",
"Requests splitted (%)"
)
p <-
ggplot(stats, aes_string(x = "type", y = unlim_cols[1])) +
geom_boxplot(outlier.shape = NA) +
geom_point(
aes_string(
x = "type",
),
shape = 21,
position = position_jitter(width = 0.2, height = 0),
alpha = 0.5
) +
labs(
x = "Type",
y = unlim_cols_desc[1],
# title = paste(unlim_cols_desc[1], "-", inst_set_desc[i])
) +
coord_cartesian(ylim = c(0, 18)) +
scale_y_continuous(breaks = seq(0, 18, by = 3))
print(p)
filename <-
paste(
"plots/",
inst_set[i],
"/stats_insts/types/boxplot_stats_by_type_",
unlim_cols[1],
"_",
inst_set[i],
".pdf",
sep = ""
)
ggsave(filename,
plot = p,
width = 5,
height = 6)
#########################################
