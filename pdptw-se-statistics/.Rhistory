####################
y_func <- function(n_regions) {
ifelse(n_regions == "2", 3.841, 7.815)
}
chi_squared_table <- data.frame(
xmin = stats$n_regions_num - 0.5,
xmax = stats$n_regions_num + 0.5,
ymin = y_func(stats$n_regions) - 0.00000000001,
ymax = y_func(stats$n_regions) + 0.00000000001,
Group = stats$n_regions_num
)
p <-
ggplot(stats, aes_string(x = "type", y = "chi_squared_z")) +
geom_boxplot(outlier.shape = NA) +
geom_point(
aes_string(
x = "type",
),
shape = 21,
position = position_jitter(width = 0.2, height = 0),
alpha = 0.5
) +
geom_rect(
data = chi_squared_table,
aes(
xmin = xmin,
xmax = xmax,
ymin = ymin,
ymax = ymax,
),
color = "red",
alpha = 0.3,
inherit.aes = FALSE,
) +
labs(
x = "Type",
y = unlim_cols_desc[6],
# title = paste(unlim_cols_desc[6], "-", inst_set_desc[i])
) +
coord_cartesian(ylim = c(0, 14)) +
scale_y_continuous(breaks = seq(0, 14, by = 2))
print(p)
filename <-
paste(
"plots/",
inst_set[i],
"/stats_insts/types/boxplot_stats_by_type_chi_squared_",
inst_set[i],
".pdf",
sep = ""
)
ggsave(filename,
plot = p,
width = 5,
height = 6)
######################
p <- ggplot(stats, aes(x = as.factor(type), y = reqs_split)) +
geom_boxplot() +
labs(
x = "Type",
y = unlim_cols_desc[7],
title = paste(unlim_cols_desc[7], "-", inst_set_desc[i])
) +
coord_cartesian(ylim = c(0, 100))
print(p)
filename <-
paste(
"plots/",
inst_set[i],
"/stats_insts/types/boxplot_stats_by_type_reqs_split_",
inst_set[i],
".pdf",
sep = ""
)
ggsave(filename,
plot = p,
width = 5,
height = 6)
}
